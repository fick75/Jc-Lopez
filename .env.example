# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: one-time "master key" used only to create the FIRST
# administrator account (see the Setup screen in /admin). Each admin then
# logs in with their own email + password, not with this value. Keep it
# secret, used once, and known only to whoever sets up the system.
ADMIN_PASSWORD="admin_citro_secreto"

# --- PostgreSQL connection (required to run outside AI Studio) ---
# AI Studio injects these automatically for its own managed database.
# On any other host (Render, Fly.io, a VM, etc.) set them to point at
# your own Postgres instance, e.g. a free Neon (neon.tech) database.
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="postgres"
SQL_DB_NAME="citro_espacios"
# Set to "true" when connecting to an external managed database that
# requires SSL (Neon, Render Postgres, Supabase, etc). Leave unset for
# a local/AI Studio database.
SQL_SSL="false"

# Same credentials, used only by `npx drizzle-kit push` to create/update
# the database schema (usually identical to the vars above).
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="postgres"

# NODE_ENV: set to "production" when running `npm start` after `npm run build`.
NODE_ENV="production"
